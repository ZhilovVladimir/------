{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./исходники",
    "outDir": "../результаты/терминал",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "исходники/**/*.ts"
  ],
  "exclude": [
    "../node_modules",
    "../результаты"
  ]
}

{
    "name": "ulitka",
    "version": "0.1.0",
    "description": "Компилятор русского языка программирования «Улитка»",
    "keywords": [
        "русский",
        "язык",
        "программирование",
        "компилятор",
        "улитка"
    ],
    "author": "Владимир",
    "license": "MIT",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --strictPort",
        "приложение": "electron .",
        "улитка": "powershell -ExecutionPolicy Bypass -File \"./запуск_улитки.ps1\"",
        "проверка": "tsc -p tsconfig.json --noEmit && tsc -p терминал/tsconfig.json --noEmit && tsc -p tsconfig.сервер.json --noEmit",
        "сборка": "vite build && tsc -p tsconfig.сервер.json"
    },
    "devDependencies": {
        "@types/node": "^26.4.0",
        "electron": "^44.7.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.2"
    },
    "main": "приложение/главный.cjs",
    "dependencies": {
        "monaco-editor": "^0.57.0"
    }
}
